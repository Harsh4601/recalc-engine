# basic arithmetic, references, operator precedence
set A1 = 10
set A2 = 20
set B1 = =A1+A2
set B2 = =A1*A2
set B3 = =A2-A1
set B4 = =A2/A1
set B5 = =2^10
set B6 = =A1+A2*2
set B7 = =(A1+A2)*2
set B8 = =-A1+5
expect B1 = 30
expect B2 = 200
expect B3 = 10
expect B4 = 2
expect B5 = 1024
expect B6 = 50
expect B7 = 60
expect B8 = -5
